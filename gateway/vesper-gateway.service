[Unit]
Description=Vesper authenticated Codex gateway
After=network-online.target codex-app-server.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/vesper-gateway
Environment=VESPER_GATEWAY_TOKEN_FILE=/home/ubuntu/.codex/app-server-token
Environment=VESPER_GATEWAY_COMPACTION=1
Environment=VESPER_GATEWAY_COMPACTION_THRESHOLD=80000
ExecStart=/usr/bin/node /home/ubuntu/vesper-gateway/server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M

[Install]
WantedBy=multi-user.target
